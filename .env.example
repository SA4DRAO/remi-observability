# Remi Observability — Environment Configuration
# Copy this file to .env and set your API keys below.
# Everything else has sensible defaults for Docker Compose.

# ── LLM providers ─────────────────────────────────────────────────────────────
# OpenRouter powers both the example agents and the LLM-as-judge feature when
# set. Without it, both fall back to direct OpenAI via OPENAI_API_KEY.
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# ── Optional overrides ────────────────────────────────────────────────────────
# REMI_API_KEY=acme-admin-key        # Dashboard key baked into the frontend build (dev seed)
# JUDGE_MODEL=openai/gpt-4o-mini     # Judge model (OpenRouter naming)
# OPENAI_MODEL=openai/gpt-4o-mini    # Model used by the example agents
# OPENAI_BASE_URL=                   # Override the agents' API base URL

# ── Example agents (defaults target the local stack + seeded sample org) ─────
# REMI_INGEST_KEY=acme-ingest-key    # Org API key agents send with OTLP traces
# REMI_ORG_ID=acme                   # Fallback org resource attribute
# REMI_AGENT_ID=demo-agent
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:3100   # Backend's authenticated OTLP proxy
