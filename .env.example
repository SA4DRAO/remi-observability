# Remi Observability — Environment Configuration
# Copy this file to .env and set your API key below.
# Everything else has sensible defaults for Docker Compose.

# ── Required ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=            # Your OpenAI API key — required to run example agents

# ── Optional overrides ────────────────────────────────────────────────────────
# REMI_API_KEY=test-key-123          # Bearer token used by all services (default: test-key-123)
# OPENAI_BASE_URL=https://api.openai.com/v1  # Swap for Anthropic / other OpenAI-compat endpoints
# OPENAI_MODEL=gpt-4o-mini           # Model used for examples and the LLM-as-a-judge feature

# ── OTel Collector defaults (override if running outside Docker) ──────────────
# REMI_ORG_ID=demo-org
# REMI_AGENT_ID=demo-agent
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
