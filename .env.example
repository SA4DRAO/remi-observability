# Remi Observability — Environment Configuration
# Copy this file to .env and set your API keys below.
# Everything else has sensible defaults for Docker Compose.

# ── LLM providers ─────────────────────────────────────────────────────────────
# OpenRouter powers both the example agents and the LLM-as-judge feature when
# set. Without it, both fall back to direct OpenAI via OPENAI_API_KEY.
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Exa (https://exa.ai) powers research_agent.py's search_papers tool with live
# web search. Without it, the tool returns found=false instead of failing.
EXA_API_KEY=

# ── Optional overrides ────────────────────────────────────────────────────────
# REMI_API_KEY=acme-admin-key        # Dashboard key baked into the frontend build (dev seed)
# JUDGE_MODEL=openai/gpt-4o-mini     # Judge model (OpenRouter naming)
# OPENAI_MODEL=openai/gpt-4o-mini    # Model used by the example agents
# OPENAI_BASE_URL=                   # Override the agents' API base URL
# RATE_LIMIT_PER_MINUTE=600          # Per-org request cap across read + ingest; 0 disables

# ── Datastore credentials ────────────────────────────────────────────────────
# Default to the dev values when unset. Neither store publishes a host port, so
# they are only reachable inside the compose network — but set real passwords
# before hosting this anywhere, and set them BEFORE first start: the init scripts
# and the data volumes are created once, so changing these later means either a
# fresh volume or an ALTER USER by hand.
# POSTGRES_USER=remi_user
# POSTGRES_PASSWORD=
# POSTGRES_DB=remi_db
# CLICKHOUSE_USER=remi_user
# CLICKHOUSE_PASSWORD=
# CLICKHOUSE_DB=remi

# ── Hosted deployment (docker compose --profile prod up -d) ──────────────────
# Only needed when running Caddy + oauth2-proxy in front. Unset, the local stack
# behaves exactly as before: no TLS, no SSO, bearer key only.
# REMI_DOMAIN=remi.example.com              # Caddy auto-provisions TLS for this
# PROXY_SHARED_SECRET=                      # openssl rand -hex 32
# OAUTH2_CLIENT_ID=                         # Google OAuth client for the dashboard
# OAUTH2_CLIENT_SECRET=
# OAUTH2_COOKIE_SECRET=                     # openssl rand -base64 32 | head -c 32 | base64
# OAUTH2_EMAIL_DOMAINS=example.com          # who may reach the login (default: *)
#
# Dashboard access is granted per person by inserting into org_members —
# the SSO provider proves the email, that row grants the org and its scopes:
#   INSERT INTO org_members (email, org_id, scopes)
#   VALUES ('someone@customer.com', 'acme', ARRAY['read:sessions','read:spans']);

# ── Example agents (defaults target the local stack + seeded sample org) ─────
# REMI_INGEST_KEY=acme-ingest-key    # Org API key agents send with OTLP traces
# REMI_ORG_ID=acme                   # Fallback org resource attribute
# REMI_AGENT_ID=demo-agent
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:3100   # Backend's authenticated OTLP proxy
